1 ICON "shocora.ico"

// VER_* come from build.rs, which reads the package's version.
1 VERSIONINFO
FILEVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
PRODUCTVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
FILEFLAGSMASK 0x3F
FILEFLAGS 0
FILEOS 0x40004
FILETYPE 1
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "DiaSird"
            VALUE "FileDescription", "shocora Wii U emulator"
            VALUE "FileVersion", VER_STRING
            VALUE "InternalName", "shocora"
            VALUE "OriginalFilename", "shocora.exe"
            VALUE "ProductName", "shocora"
            VALUE "ProductVersion", VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
